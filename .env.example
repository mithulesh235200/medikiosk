# ---------------------------------------------------------------------------
# MediKiosk environment — works locally (server.ts) and on Vercel (api/*)
# ---------------------------------------------------------------------------

# GEMINI_API_KEY (required for AI triage, summaries, OCR, interaction checks).
# Without it the app still runs with a built-in rule-based fallback engine.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL (optional, default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# STAFF_SESSION_SECRET (recommended): signs doctor session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to service_role key if unset — set it explicitly in production.
STAFF_SESSION_SECRET=

# ALLOW_DOCTOR_SELF_REGISTER (optional, default: true): lets new doctors
# self-register from the login screen. Set to "false" in production and
# pre-provision doctors via supabase/schema.sql instead.
ALLOW_DOCTOR_SELF_REGISTER=true

# APP_URL: public URL of the deployment (used for callbacks/links).
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Supabase (required for persistent patient queue on Vercel)
# Without these, data lives only in server memory / data/patients.json.
# ---------------------------------------------------------------------------
# 1. Create a project at https://supabase.com/dashboard
# 2. Run supabase/schema.sql in the SQL Editor
# 3. Copy Project URL + anon key (Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional but recommended: service_role key (server-side only, never expose
# to the browser). Lets /api bypass RLS for kiosk writes.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Frontend (Vite) variables — needed ONLY for direct Supabase access from the
# browser. The /api routes above use the server-side names.
# In Vercel Dashboard > Settings > Environment Variables, set BOTH sets:
#   SUPABASE_URL            + VITE_SUPABASE_URL            (same value)
#   SUPABASE_ANON_KEY       + VITE_SUPABASE_ANON_KEY       (same value)
#   GEMINI_API_KEY          (server only — do NOT prefix with VITE_)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

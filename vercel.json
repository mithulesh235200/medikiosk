{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/.well-known/(.*)", "destination": "/.well-known/$1" },
    { "source": "/api/patients/:id/status", "destination": "/api/patient-action?id=:id&action=status" },
    { "source": "/api/patients/:id/annotate", "destination": "/api/patient-action?id=:id&action=annotate" },
    { "source": "/((?!api/|\\.well-known/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
